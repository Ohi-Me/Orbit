# ---------------------------------------------------------------------------
# Orbit — configuration
#
# Everything here is OPTIONAL. With none of it set, the platform runs on
# SQLite with deterministic fallbacks and reports its reduced capability at
# GET /api/health rather than pretending to be at full fidelity.
# ---------------------------------------------------------------------------

# --- storage ---------------------------------------------------------------
# SQLite by default. Point at Postgres in deployment; the ORM is identical.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/orbit

# --- security --------------------------------------------------------------
# MUST be set in any real deployment. /api/health warns while it is the default.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# JWT_EXPIRE_MINUTES=720
# AUTH_REQUIRED=false

# --- CORS ------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:3000

# --- LLM (optional) --------------------------------------------------------
# Enables the LLM research planner and RAG answer synthesis.
# Without it: deterministic rule-based planning and extractive evidence only.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5

# --- external data ---------------------------------------------------------
# SEC requires a self-identifying User-Agent; a generic one gets blocked.
# SEC_USER_AGENT=orbit-research your.email@example.com
# ALLOW_LIVE_MARKET_DATA=true
# ALLOW_LIVE_FILINGS=true
# ALLOW_LIVE_MACRO=true

# --- models ----------------------------------------------------------------
# Set to false in an air-gapped environment; retrieval falls back to BM25 and
# sentiment falls back to a labelled keyword baseline.
# ALLOW_MODEL_DOWNLOAD=true
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# FINBERT_MODEL=ProsusAI/finbert

# --- experiment tracking ---------------------------------------------------
# ENABLE_MLFLOW=true
# MLFLOW_TRACKING_URI=./mlruns
# MLFLOW_EXPERIMENT=orbit

# --- execution -------------------------------------------------------------
# MAX_CONCURRENT_RUNS=2
# LOG_FORMAT=console   # set to "json" in production
# LOG_LEVEL=INFO
